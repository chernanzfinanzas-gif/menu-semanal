    <SteadyState Duration="60" Power="0.75" Cadence="90"/>
    <SteadyState Duration="60" Power="0.75" Cadence="90"/>
    <SteadyState Duration="60" Power="0.75" Cadence="100">
      <textevent timeoffset="0" message="Un minuto a 95-100 rpm con la misma potencia. Piernas sueltas, sin apretar."/>
    </SteadyState>
    <SteadyState Duration="60" Power="0.47" Cadence="90">
      <textevent timeoffset="0" message="Un minuto suave para que el pulso baje despues de la cadencia. Respira."/>
    </SteadyState>
    <SteadyState Duration="60" Power="0.75" Cadence="90"/>
    <SteadyState Duration="60" Power="0.47" Cadence="90">
      <textevent timeoffset="0" message="Un minuto suave y llega el apreton: cinco minutos subiendo. Aqui manda el VATIO, no el pulso."/>
    </SteadyState>
    <SteadyState Duration="60" Power="0.72" Cadence="90">
      <textevent timeoffset="0" message="Apreton. Cinco minutos de rampa. Respira hondo y no bloquees la respiracion en ningun momento."/>
    </SteadyState>
    <SteadyState Duration="60" Power="0.80" Cadence="90"/>
    <SteadyState Duration="60" Power="0.88" Cadence="90"/>
    <SteadyState Duration="60" Power="0.96" Cadence="90"/>
    <SteadyState Duration="60" Power="1.00" Cadence="90">
      <textevent timeoffset="0" message="Ultimo minuto, y es tuyo: esta es la base. Si te queda, sube con el boton +."/>
    </SteadyState>
    <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.40"/>
  </workout>
